# --- Database (Neon) ---------------------------------------------------------
# Neon console → your project → Connect → copy the connection string.
# The "-pooler" host is fine for the app. For migrations you can optionally
# set DATABASE_URL_UNPOOLED to the direct (non-pooler) string.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Tests TRUNCATE every table. Point this at a separate Neon branch (e.g. "test"),
# never at the database you demo from.
TEST_DATABASE_URL=postgres://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Payments ----------------------------------------------------------------
# Shared secret for the X-Signature HMAC. The send-webhook script reads it too.
WEBHOOK_SECRET=dev_webhook_secret_change_me
ENABLE_PAYMENT_SIMULATOR=true

# --- App ---------------------------------------------------------------------
PORT=4000
HOLD_SECONDS=120
EXPIRE_JOB_INTERVAL_MS=5000
CORS_ORIGIN=http://localhost:5173
# Used by `npm run send-webhook`
API_URL=http://localhost:4000
